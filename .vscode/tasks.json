{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start Frontend (React)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "crimemind"
      },
      "problemMatcher": []
    },
    {
      "label": "🐍 Install Backend Dependencies",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/functions/crimemind_backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "⚡ Start Backend (FastAPI)",
      "type": "shell",
      "command": "uvicorn main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/functions/crimemind_backend",
        "env": {
          "GEMINI_API_KEY": "${env:GEMINI_API_KEY}"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "crimemind"
      },
      "problemMatcher": []
    },
    {
      "label": "🔨 Build Frontend (Production)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "🎯 Start Full App (Frontend + Backend)",
      "dependsOn": [
        "🚀 Start Frontend (React)",
        "⚡ Start Backend (FastAPI)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
